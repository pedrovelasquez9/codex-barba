---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts } from "../lib/posts";

const RECENT_POSTS_COUNT = 6;

const [latestPost, ...olderPosts] = await getPublishedPosts();
const recentPosts = olderPosts.slice(0, RECENT_POSTS_COUNT);
---

<BaseLayout title="Inicio">
  <section class="nes-container is-dark with-title">
    <h1 class="title">Bienvenido a Codex Barba</h1>
    <div class="nes-balloon from-left is-dark">
      <p>
        Una wiki retro hecha con café, Astro y NES.css por <a
          href="https://programacion-es.dev"
          target="_blank"
          >Programación en español <img
            src="/logo 8bit.webp"
            alt="logo programación en español"
            class="pee-logo"
          /></a
        >
      </p>
    </div>
  </section>

  {
    latestPost && (
      <section class="home-section">
        <h2 class="section-title">Lo último</h2>
        <PostCard post={latestPost} featured />
      </section>
    )
  }

  <section class="home-section">
    <h2 class="section-title">Contenido reciente</h2>
    <ul class="post-grid">
      {
        recentPosts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>
    <a href="/blog" class="nes-btn is-primary all-posts-link">Ver todas las entradas</a>
  </section>
</BaseLayout>

<style>
  .pee-logo {
    width: 30px;
    height: auto;
    vertical-align: baseline;
  }

  .home-section {
    margin-top: 3rem;
  }

  .section-title {
    margin-bottom: 1.5rem;
    font-size: clamp(14px, 1.4vw, 18px);
  }

  .section-title::before {
    content: "▶ ";
    color: var(--color-accent);
  }

  .all-posts-link {
    margin-top: 2rem;
  }
</style>
