---
import { getCollection, getEntryBySlug } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SideMenu from "../components/SideMenu.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => {
    const slugName = post.slug.split("/").pop();
    return {
      params: { slug: slugName },
      props: { slugName },
    };
  });
}

const { slugName }: any = Astro.props;

const allPosts = await getCollection("posts");
const post = allPosts.find((p) => p.slug.split("/").pop() === slugName);

if (!post) {
  throw new Error(`No se encontró el post para el slug: ${slugName}`);
}

const { Content }: any = await post.render();
---

<BaseLayout title={post?.data?.title} description={post?.data?.description}>
  <SideMenu slot="side-menu" />
  <article class="nes-container is-dark with-title article-container">
    <p class="title">{post?.data?.title}</p>

    <div class="post-meta">
      <span class="nes-text is-primary">
        Publicado el {post?.data?.publishDate?.toLocaleDateString("es-ES", { dateStyle: "long", timeZone: "UTC" })}
      </span>
      {
        post?.data?.tags && (
          <div class="tags">
            {post?.data?.tags.map((tag: string) => (
              <span class="nes-badge">
                <span class="is-primary">{tag}</span>
              </span>
            ))}
          </div>
        )
      }
    </div>

    <div class="post-content">
      <Content />
    </div>

    <a href="/" class="nes-btn back-btn">← Ir al inicio</a>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll(".post-content pre").forEach((pre) => {
    const btn = document.createElement("button");
    btn.className = "copy-btn";
    btn.type = "button";
    btn.textContent = "Copiar";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? "");
        btn.textContent = "¡Copiado!";
      } catch {
        btn.textContent = "No se pudo copiar";
      }
      setTimeout(() => (btn.textContent = "Copiar"), 1500);
    });
    pre.append(btn);
  });
</script>

<style>
  /* NES.css fija el ancho del badge (10.5em) y posiciona el texto en absoluto:
     aquí el badge se ajusta a su texto */
  .nes-badge {
    width: auto;
    height: auto;
    font-size: 12px;
  }

  .nes-badge span {
    position: static;
    display: inline-block;
    width: auto;
  }

  .back-btn {
    margin-top: 2rem;
  }

  .post-meta {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 4px solid #444;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .post-content {
    line-height: 1.35;
    margin-top: 2rem;
    max-width: 70ch;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .post-content :global(p) {
    margin-bottom: 1rem;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* Bloque de código con marco NES: etiqueta de lenguaje + botón de copiar */
  .post-content :global(pre) {
    position: relative;
    padding: 0 1rem 1rem;
    border: 4px solid #adafbc;
    box-shadow: 4px 4px 0 #000;
    overflow-x: auto;
  }

  .post-content :global(pre)::before {
    content: attr(data-language);
    display: block;
    margin: 0 -1rem 1rem;
    padding: 0.5rem 1rem;
    border-bottom: 4px solid #adafbc;
    font-family: var(--font-pixel);
    font-size: 10px;
    text-transform: uppercase;
    color: #adafbc;
  }

  .post-content :global(pre[data-language="plaintext"])::before {
    content: "texto";
  }

  .post-content :global(.copy-btn) {
    position: absolute;
    top: 0.25rem;
    right: 0.5rem;
    padding: 0.25rem 0.5rem;
    border: 0;
    background: none;
    color: #adafbc;
    font-family: var(--font-pixel);
    font-size: 10px;
    cursor: pointer;
  }

  .post-content :global(.copy-btn:hover),
  .post-content :global(.copy-btn:focus-visible) {
    color: #fff;
  }

  @media (max-width: 676px) {
    .article-container {
      padding: 1rem;
      border-color: transparent;
    }

    .back-btn {
      width: 100%;
    }
  }
</style>
