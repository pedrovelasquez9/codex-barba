---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryChip from "../components/CategoryChip.astro";
import { getPostCategories } from "../lib/categories";
import {
  formatDate,
  getPostSlug,
  getPostThumbnail,
  getPostUrl,
  getPublishedPosts,
  getReadingMinutes,
  type Post,
} from "../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: getPostSlug(post) }, props: { post } }));
}

interface Props {
  post: Post;
}

const MIN_HEADINGS_FOR_TABLE_OF_CONTENTS = 4;

const { post } = Astro.props;
const { Content, headings } = await post.render();

const tableOfContents = headings.filter((heading) => heading.depth <= 2);
const showTableOfContents = tableOfContents.length >= MIN_HEADINGS_FOR_TABLE_OF_CONTENTS;

const postCategories = getPostCategories(post.data.tags);
const [mainCategory] = postCategories;
const categoryPosts = mainCategory
  ? (await getPublishedPosts())
      .filter((categoryPost) => getPostCategories(categoryPost.data.tags).includes(mainCategory))
      .reverse()
  : [];
const position = categoryPosts.findIndex((categoryPost) => categoryPost.slug === post.slug);
const previousPost = position > 0 ? categoryPosts[position - 1] : undefined;
const nextPost = position >= 0 ? categoryPosts[position + 1] : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={getPostThumbnail(post)}
>
  <div class="reading-progress" aria-hidden="true"></div>

  <article class="nes-container is-dark with-title" data-pagefind-body>
    <p class="title" data-pagefind-meta="title">{post.data.title}</p>

    <div class="post-meta" data-pagefind-ignore>
      <p class="nes-text is-primary">
        Publicado el <time datetime={post.data.publishDate.toISOString()}>
          {formatDate(post.data.publishDate)}
        </time> · {getReadingMinutes(post)} min de lectura
      </p>
      {
        postCategories.length > 0 && (
          <div class="post-categories">
            {postCategories.map((category) => (
              <CategoryChip category={category} />
            ))}
          </div>
        )
      }
    </div>

    {
      showTableOfContents && (
        <nav class="table-of-contents" data-pagefind-ignore aria-labelledby="table-of-contents-title">
          <p id="table-of-contents-title" class="table-of-contents-title">Índice</p>
          <ol>
            {tableOfContents.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="post-content">
      <Content />
    </div>

    {
      (previousPost || nextPost) && (
        <nav class="post-pager" data-pagefind-ignore aria-label={`Más de ${mainCategory?.name}`}>
          {previousPost && (
            <a href={getPostUrl(previousPost)} class="pager-link is-previous">
              <span class="pager-label">« Anterior</span>
              <span>{previousPost.data.title}</span>
            </a>
          )}
          {nextPost && (
            <a href={getPostUrl(nextPost)} class="pager-link is-next">
              <span class="pager-label">Siguiente »</span>
              <span>{nextPost.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    <a href="/" class="nes-btn back-btn" data-pagefind-ignore>« Ir al inicio</a>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll(".post-content pre").forEach((pre) => {
    const copyButton = document.createElement("button");
    copyButton.className = "copy-btn";
    copyButton.type = "button";
    copyButton.textContent = "Copiar";
    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? "");
        copyButton.textContent = "¡Copiado!";
      } catch {
        copyButton.textContent = "No se pudo copiar";
      }
      setTimeout(() => (copyButton.textContent = "Copiar"), 1500);
    });
    pre.append(copyButton);
  });
</script>

<style>
  .reading-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .reading-progress {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1002;
      width: 100%;
      height: 6px;
      background-color: var(--color-accent);
      transform-origin: left;
      animation: reading-progress steps(40) both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes reading-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .post-meta {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 4px solid var(--color-surface-hover);
  }

  .post-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .table-of-contents {
    max-width: 70ch;
    margin-top: 2rem;
    padding: 1rem 1.5rem;
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-pixel);
  }

  .table-of-contents-title {
    margin-bottom: 0.75rem;
    font-family: var(--font-pixel);
    font-size: 12px;
  }

  .table-of-contents ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .table-of-contents .depth-2 {
    padding-left: 1.5rem;
  }

  .table-of-contents a {
    display: flex;
    gap: 0.5rem;
    color: var(--color-text);
  }

  .table-of-contents a::before {
    content: "▶";
    flex: none;
    visibility: hidden;
  }

  .table-of-contents a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .table-of-contents a:hover::before,
  .table-of-contents a:focus-visible::before {
    visibility: visible;
  }

  .post-content {
    max-width: 70ch;
    margin-top: 2rem;
    line-height: 1.35;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .post-content :global(p) {
    margin-bottom: 1rem;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
  }

  .post-content :global(pre) {
    position: relative;
    padding: 0 1rem 1rem;
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-pixel);
    overflow-x: auto;
  }

  .post-content :global(pre)::before {
    content: attr(data-language);
    display: block;
    margin: 0 -1rem 1rem;
    padding: 0.5rem 1rem;
    border-bottom: 4px solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-pixel);
    font-size: 10px;
    text-transform: uppercase;
  }

  .post-content :global(pre[data-language="plaintext"])::before {
    content: "texto";
  }

  .post-content :global(.copy-btn) {
    position: absolute;
    top: 0.25rem;
    right: 0.5rem;
    padding: 0.25rem 0.5rem;
    border: 0;
    background: none;
    color: var(--color-muted);
    font-family: var(--font-pixel);
    font-size: 10px;
    cursor: pointer;
  }

  .post-content :global(.copy-btn:hover),
  .post-content :global(.copy-btn:focus-visible) {
    color: var(--color-text);
  }

  .post-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    color: var(--color-text);
    text-decoration: none;
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-pixel);
  }

  .pager-link:hover {
    color: var(--color-accent);
    text-decoration: none;
    border-color: var(--color-text);
  }

  .pager-link.is-next {
    grid-column: 2;
    text-align: right;
  }

  .pager-label {
    color: var(--color-muted);
    font-family: var(--font-pixel);
    font-size: 10px;
  }

  .back-btn {
    margin-top: 2rem;
  }

  @media (max-width: 676px) {
    .post-pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .pager-link.is-next {
      grid-column: 1;
    }

    .back-btn {
      width: 100%;
    }
  }
</style>
