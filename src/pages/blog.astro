---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { categories, getPostCategories } from "../lib/categories";
import { getPublishedPosts } from "../lib/posts";

const posts = (await getPublishedPosts()).map((post) => ({
  post,
  categoryIds: getPostCategories(post.data.tags).map((category) => category.id),
}));
const usedCategories = categories.filter((category) =>
  posts.some(({ categoryIds }) => categoryIds.includes(category.id))
);
---

<BaseLayout title="Blog">
  <section class="nes-container is-dark with-title">
    <h1 class="title">Blog</h1>

    <div class="category-filter" role="group" aria-label="Filtrar por categoría">
      <button type="button" class="category-chip" data-category="all" aria-pressed="true">
        Todas
      </button>
      {
        usedCategories.map((category) => (
          <button
            type="button"
            class="category-chip"
            data-category={category.id}
            aria-pressed="false"
            style={`--category-color: ${category.color}; --category-text: ${category.textColor}`}
          >
            {category.name}
          </button>
        ))
      }
    </div>

    <ul class="post-grid">
      {
        posts.map(({ post, categoryIds }) => (
          <li data-categories={categoryIds.join(" ")}>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLElement>(".category-filter")!;
  const chips = filter.querySelectorAll<HTMLButtonElement>(".category-chip");
  const postItems = document.querySelectorAll<HTMLLIElement>(".post-grid > li");

  filter.addEventListener("click", (event) => {
    const selectedChip = (event.target as Element).closest<HTMLButtonElement>(".category-chip");
    if (!selectedChip) return;

    const category = selectedChip.dataset.category!;
    chips.forEach((chip) => chip.setAttribute("aria-pressed", String(chip === selectedChip)));
    postItems.forEach((item) => {
      item.hidden = category !== "all" && !item.dataset.categories!.split(" ").includes(category);
    });
  });
</script>

<style>
  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .category-chip {
    --category-color: var(--color-accent);
    --category-text: var(--color-text);

    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-bg);
    color: var(--color-text);
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-pixel-small);
    font-family: var(--font-pixel);
    font-size: 10px;
    cursor: pointer;
  }

  .category-chip::before {
    content: "";
    width: 10px;
    height: 10px;
    background-color: var(--category-color);
  }

  .category-chip:hover {
    background-color: var(--color-surface-hover);
  }

  .category-chip[aria-pressed="true"] {
    background-color: var(--category-color);
    color: var(--category-text);
    border-color: var(--color-text);
  }

  .category-chip[aria-pressed="true"]::before {
    background-color: var(--category-text);
  }
</style>
