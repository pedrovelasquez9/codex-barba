---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Acerca de">
  <section class="nes-container is-dark with-title">
    <h1 class="title">Acerca de Codex Barba</h1>

    <div class="character-section">
      <img class="mascot" src="/logo 8bit beard.webp" alt="" width="96" height="133" />
      <div class="nes-balloon from-left is-dark">
        <p>
          Codex Barba es una wiki retro creada con amor por <a
            href="https://programacion-es.dev"
            target="_blank">Programación en español</a
          >. Utiliza Astro y NES.css para ofrecer una experiencia nostálgica y
          acceso rápido al contenido de la comunidad y a los diagramas y
          archivos teóricos complementarios creados para los vídeo tutoriales.
        </p>
      </div>
    </div>

    <div class="features">
      <h2>Características:</h2>
      <ul class="nes-list is-disc">
        <li>Construido con Astro v4+</li>
        <li>Estilizado con NES.css</li>
        <li>Contenido escrito en Markdown (mdx)</li>
      </ul>
    </div>

    <div class="character-section is-reversed">
      <img class="mascot" src="/logo 8bit beard.webp" alt="" width="96" height="133" />
      <div class="nes-balloon from-right is-dark">
        <h3>¿Quieres colaborar con el proyecto?</h3>
        <p>
          Puedes contribuir con el proyecto haciendo un fork del repo de GitHub:
          <a
            href="https://github.com/pedrovelasquez9/codex-barba"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ir al repo de Codex Barba
          </a>
        </p>
      </div>
    </div>

    <a href="/" class="nes-btn back-btn">« Ir al inicio</a>
  </section>
</BaseLayout>

<style>
  .character-section {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    margin-top: 2rem;
  }

  .character-section.is-reversed {
    flex-direction: row-reverse;
  }

  .mascot {
    flex: none;
    width: 96px;
    height: auto;
    image-rendering: pixelated;
  }

  .features {
    margin-top: 2rem;
  }

  .back-btn {
    margin-top: 2rem;
  }

  @media (max-width: 676px) {
    .character-section,
    .character-section.is-reversed {
      flex-direction: column-reverse;
      align-items: flex-start;
    }

    .back-btn {
      width: 100%;
    }
  }
</style>
