---
import { getPostCategories } from "../lib/categories";
import { formatDate, getPostThumbnail, getPostUrl, type Post } from "../lib/posts";

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const [mainCategory] = getPostCategories(post.data.tags);
const thumbnail = getPostThumbnail(post);
const categoryStyle = mainCategory
  ? `--category-color: ${mainCategory.color}; --category-text: ${mainCategory.textColor}`
  : undefined;
---

<a href={getPostUrl(post)} class:list={["post-card", { "is-featured": featured }]} style={categoryStyle}>
  {
    thumbnail ? (
      <img
        class="post-card-cover"
        src={thumbnail}
        alt=""
        width="480"
        height="270"
        loading={featured ? "eager" : "lazy"}
        decoding="async"
      />
    ) : (
      <span class="post-card-cover post-card-placeholder">
        {mainCategory?.name ?? "Codex Barba"}
      </span>
    )
  }
  <span class="post-card-body">
    {mainCategory && <span class="post-card-category">{mainCategory.name}</span>}
    <h2 class="post-card-title">{post.data.title}</h2>
    <span class="post-card-description">{post.data.description}</span>
    <time class="post-card-date" datetime={post.data.publishDate.toISOString()}>
      {formatDate(post.data.publishDate)}
    </time>
  </span>
</a>

<style>
  .post-card {
    --category-color: var(--color-border);
    --category-text: var(--color-bg);

    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    color: var(--color-text);
    text-decoration: none;
    background-color: var(--color-bg);
    border: 4px solid var(--color-border);
    border-top: 8px solid var(--category-color);
    box-shadow: var(--shadow-pixel);
  }

  .post-card:hover,
  .post-card:focus-visible {
    color: var(--color-text);
    text-decoration: none;
    border-color: var(--color-text);
    border-top-color: var(--category-color);
  }

  .post-card:hover .post-card-title,
  .post-card:focus-visible .post-card-title {
    color: var(--color-accent);
  }

  .post-card-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 4px solid var(--color-border);
  }

  .post-card-placeholder {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    padding: 1rem;
    background-color: var(--category-color);
    color: var(--category-text);
    font-family: var(--font-pixel);
    font-size: 12px;
    line-height: 1.6;
    text-align: center;
  }

  .post-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
  }

  .post-card-category {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-muted);
    font-family: var(--font-pixel);
    font-size: 9px;
  }

  .post-card-category::before {
    content: "";
    width: 10px;
    height: 10px;
    background-color: var(--category-color);
  }

  .post-card-title {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
  }

  .post-card-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-card-date {
    margin-top: auto;
    color: var(--color-muted);
    font-size: 0.85em;
  }

  .post-card.is-featured .post-card-title {
    font-size: clamp(14px, 1.6vw, 18px);
  }

  .post-card.is-featured .post-card-description {
    -webkit-line-clamp: unset;
  }

  @media (min-width: 768px) {
    .post-card.is-featured {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .post-card.is-featured .post-card-cover {
      height: 100%;
      border-bottom: 0;
      border-right: 4px solid var(--color-border);
    }
  }
</style>
