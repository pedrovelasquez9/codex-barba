---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedTitleAndUrl = encodeURIComponent(`${title} ${url}`);

const networks = [
  { name: "X", href: `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}` },
  { name: "Bluesky", href: `https://bsky.app/intent/compose?text=${encodedTitleAndUrl}` },
  { name: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
  { name: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { name: "WhatsApp", href: `https://wa.me/?text=${encodedTitleAndUrl}` },
  { name: "Telegram", href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}` },
];
---

<details class="share">
  <summary class="share-toggle">Compartir</summary>
  <div class="share-panel" data-share-title={title} data-share-url={url}>
    <ul class="share-options">
      {
        networks.map((network) => (
          <li>
            <a
              href={network.href}
              class="share-option"
              target="_blank"
              rel="noopener noreferrer"
            >
              {network.name}
            </a>
          </li>
        ))
      }
      <li>
        <button type="button" class="share-option" data-share-action="copy" aria-live="polite">
          Copiar enlace
        </button>
      </li>
      <li>
        <button type="button" class="share-option" data-share-action="native" hidden>
          Más opciones…
        </button>
      </li>
    </ul>
  </div>
</details>

<script>
  import { copyWithFeedback } from "../lib/clipboard";

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".share-panel").forEach((panel) => {
      const title = panel.dataset.shareTitle!;
      const url = panel.dataset.shareUrl!;
      const copyButton = panel.querySelector<HTMLButtonElement>('[data-share-action="copy"]')!;
      const nativeShareButton = panel.querySelector<HTMLButtonElement>('[data-share-action="native"]')!;

      copyButton.addEventListener("click", () => copyWithFeedback(copyButton, url));

      nativeShareButton.hidden = !("share" in navigator);
      nativeShareButton.addEventListener("click", () => {
        navigator.share({ title, url }).catch(() => undefined);
      });
    });
  });
</script>

<style>
  .share {
    margin-top: 1rem;
  }

  .share-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-accent);
    color: var(--color-text);
    border: 2px solid var(--color-text);
    box-shadow: var(--shadow-pixel-small);
    font-family: var(--font-pixel);
    font-size: 10px;
    line-height: 1.4;
    list-style: none;
    cursor: pointer;
  }

  .share-toggle::-webkit-details-marker {
    display: none;
  }

  .share-toggle::after {
    content: "+";
  }

  .share[open] .share-toggle::after {
    content: "-";
  }

  .share-panel {
    margin-top: 0.75rem;
    padding: 0.75rem;
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-pixel);
  }

  .share-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .share-option {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-bg);
    color: var(--color-text);
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-pixel-small);
    font-family: var(--font-pixel);
    font-size: 10px;
    line-height: 1.4;
    text-decoration: none;
    cursor: pointer;
  }

  .share-option:hover,
  .share-option:focus-visible {
    color: var(--color-text);
    text-decoration: none;
    background-color: var(--color-surface-hover);
  }
</style>
