---
interface Props {
  id: string;
  title?: string;
}

const { id, title = "Vídeo de YouTube" } = Astro.props;
---

<div class="youtube-embed" data-video-id={id} data-title={title}>
  <button type="button" class="youtube-play" aria-label={`Reproducir vídeo: ${title}`}>
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
    <span class="youtube-play-icon" aria-hidden="true"></span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".youtube-embed").forEach((embed) => {
    embed.querySelector("button")!.addEventListener(
      "click",
      () => {
        const player = document.createElement("iframe");
        player.src = `https://www.youtube-nocookie.com/embed/${embed.dataset.videoId}?autoplay=1`;
        player.title = embed.dataset.title!;
        player.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        player.allowFullscreen = true;
        embed.replaceChildren(player);
        player.focus();
      },
      { once: true }
    );
  });
</script>

<style>
  .youtube-embed {
    width: 100%;
    max-width: 800px;
    aspect-ratio: 16 / 9;
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-pixel);
    background-color: #000;
  }

  .youtube-embed :global(iframe),
  .youtube-play {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .youtube-play {
    position: relative;
    padding: 0;
    background: none;
    cursor: pointer;
  }

  .youtube-play img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .youtube-play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 72px;
    height: 52px;
    background-color: #e52521;
    border: 4px solid #000;
    box-shadow: var(--shadow-pixel);
    transform: translate(-50%, -50%);
  }

  .youtube-play-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    border-style: solid;
    border-width: 10px 0 10px 18px;
    border-color: transparent transparent transparent #fff;
    transform: translate(-40%, -50%);
  }

  .youtube-play:hover .youtube-play-icon,
  .youtube-play:focus-visible .youtube-play-icon {
    background-color: #ff3b30;
  }

  .youtube-play:focus-visible {
    outline: 4px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
