---
import { categories, getPostCategories } from "../lib/categories";
import { getPostSlug, getPostUrl, getPublishedPosts } from "../lib/posts";

const postsOldestFirst = (await getPublishedPosts()).reverse();
const currentSlug = Astro.url.pathname.replaceAll("/", "");

const categorySections = categories
  .map((category) => ({
    category,
    posts: postsOldestFirst.filter((post) => getPostCategories(post.data.tags).includes(category)),
  }))
  .filter((section) => section.posts.length > 0)
  .sort((a, b) => b.posts.length - a.posts.length);
---

<button
  class="menu-toggle"
  type="button"
  aria-label="Categorías"
  aria-controls="side-menu"
  aria-expanded="false"
>
  <span class="menu-toggle-icon"></span>
</button>

<aside id="side-menu" class="side-menu nes-container is-dark">
  <form class="site-search" action="/buscar" role="search">
    <input
      class="nes-input is-dark"
      type="search"
      name="q"
      placeholder="Buscar..."
      aria-label="Buscar en Codex Barba"
    />
  </form>

  <p class="title categories-title">Categorías</p>

  <div class="categories-list">
    {
      categorySections.map(({ category, posts }) => (
        <details
          class="category-section"
          open={posts.some((post) => getPostSlug(post) === currentSlug)}
        >
          <summary class="category-header">
            <span class="category-color" style={`background-color: ${category.color}`} />
            <span class="category-name">{category.name}</span>
            <span class="post-count">({posts.length})</span>
          </summary>
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <a
                  href={getPostUrl(post)}
                  class="post-link"
                  aria-current={getPostSlug(post) === currentSlug ? "page" : undefined}
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
</aside>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const sideMenu = document.getElementById("side-menu")!;

  function setMenuOpen(isOpen: boolean) {
    sideMenu.classList.toggle("is-open", isOpen);
    menuToggle.setAttribute("aria-expanded", String(isOpen));
  }

  menuToggle.addEventListener("click", () => {
    setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (!sideMenu.contains(target) && !menuToggle.contains(target)) setMenuOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });
</script>

<style>
  .menu-toggle {
    display: none;
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 1001;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0;
    background-color: var(--color-bg);
    color: var(--color-text);
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-pixel);
    cursor: pointer;
  }

  .menu-toggle:active {
    transform: translate(2px, 2px);
  }

  .menu-toggle-icon {
    width: 20px;
    height: 4px;
    background-color: currentColor;
    box-shadow:
      0 -7px currentColor,
      0 7px currentColor;
  }

  .side-menu {
    position: sticky;
    top: 1rem;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    box-sizing: border-box;
    padding: 1rem;
    font-family: var(--font-pixel);
  }

  .side-menu::after {
    display: none;
  }

  .site-search {
    margin-bottom: 1.5rem;
  }

  .site-search input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-body);
    font-size: 1.15rem;
  }

  .categories-title {
    margin-bottom: 0.75rem;
    background-color: var(--color-bg);
  }

  .category-section + .category-section {
    margin-top: 1rem;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.5rem;
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-pixel-small);
    list-style: none;
    cursor: pointer;
  }

  .category-header::-webkit-details-marker {
    display: none;
  }

  .category-header:hover {
    background-color: var(--color-surface-hover);
  }

  .category-color {
    flex: none;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-border);
    opacity: 0.6;
  }

  .category-section[open] .category-color {
    opacity: 1;
  }

  .category-name {
    flex: 1;
    font-size: 10px;
    line-height: 1.4;
  }

  .post-count {
    font-size: 8px;
    color: var(--color-muted);
  }

  .post-list {
    margin: 0.5rem 0 0 0.75rem;
    padding: 0.5rem;
    list-style: none;
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
  }

  .post-list li + li {
    border-top: 1px solid rgba(173, 175, 188, 0.2);
  }

  .post-link {
    display: flex;
    gap: 0.5rem;
    padding: 0.25rem;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.15rem;
    line-height: 1.2;
    text-decoration: none;
  }

  .post-link::before {
    content: "▶";
    flex: none;
    visibility: hidden;
  }

  .post-link:hover::before,
  .post-link:focus-visible::before,
  .post-link[aria-current="page"]::before {
    visibility: visible;
  }

  .post-link:hover,
  .post-link[aria-current="page"] {
    color: var(--color-accent);
  }

  .side-menu::-webkit-scrollbar {
    width: 8px;
  }

  .side-menu::-webkit-scrollbar-track {
    background: var(--color-bg);
  }

  .side-menu::-webkit-scrollbar-thumb {
    background: var(--color-border);
  }

  @media (max-width: 1024px) {
    .menu-toggle {
      display: flex;
    }

    .side-menu {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      width: min(320px, 85vw);
      height: 100dvh;
      max-height: none;
      margin: 0;
      padding-top: 72px;
      visibility: hidden;
      transform: translateX(-105%);
      transition:
        transform 0.25s ease-out,
        visibility 0.25s;
    }

    .side-menu.is-open {
      visibility: visible;
      transform: none;
      box-shadow: 0 0 0 100vmax rgba(0, 0, 0, 0.5);
    }

    .categories-title {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-menu {
      transition: none;
    }
  }
</style>
