---
import "nes.css/css/nes.min.css";
import "@fontsource/press-start-2p/latin-400.css";
import "@fontsource/vt323/latin-400.css";
import "../styles/global.css";
import pixelFontUrl from "@fontsource/press-start-2p/files/press-start-2p-latin-400-normal.woff2?url";
import bodyFontUrl from "@fontsource/vt323/files/vt323-latin-400-normal.woff2?url";
import SideMenu from "../components/SideMenu.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  showSideMenu?: boolean;
}

const {
  title,
  description = "Una wiki retro hecha con café, Astro y NES.css por Programación en español.",
  image = "/logo 8bit beard.webp",
  showSideMenu = true,
} = Astro.props;

const pageTitle = `${title} | Codex Barba`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

const pathname = Astro.url.pathname;
const currentSection = pathname === "/" ? "home" : pathname.startsWith("/about") ? "about" : "blog";
const navLinks = [
  { href: "/", label: "Inicio", section: "home" },
  { href: "/blog", label: "Blog", section: "blog" },
  { href: "/about", label: "Acerca de", section: "about" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Codex Barba" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Codex Barba" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#212529" />
    <link rel="preload" href={pixelFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <script
      defer
      data-domain="codex-barba.com"
      src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <div class="container">
      <div class="layout-grid">
        <div class="side-column">
          {showSideMenu && <SideMenu />}
        </div>

        <div class="main-column">
          <header class="site-header nes-container is-dark with-title">
            <p class="title site-title">Codex Barba</p>
            <nav class="site-nav" aria-label="Principal">
              <a href="/" class="site-logo">
                <img
                  src="/logo 8bit beard.webp"
                  alt="Codex Barba, inicio"
                  width="40"
                  height="56"
                />
              </a>
              {
                navLinks.map((link) => {
                  const isCurrent = link.section === currentSection;
                  return (
                    <a
                      href={link.href}
                      class:list={["nes-btn", isCurrent ? "is-primary" : "is-dark"]}
                      aria-current={isCurrent ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  );
                })
              }
            </nav>
          </header>

          <main class="main-content">
            <slot />
          </main>

          <footer class="nes-container is-dark">
            <p>
              &copy; {new Date().getFullYear()} Codex Barba. Por <a
                href="https://programacion-es.dev">Programación en español</a
              >.
            </p>
          </footer>
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem;
    box-sizing: border-box;
    overflow-x: clip;
  }

  .layout-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 0.75rem;
  }

  .side-column,
  .main-column {
    min-width: 0;
  }

  .main-content {
    overflow-wrap: break-word;
  }

  .site-header {
    margin-bottom: 2rem;
  }

  .site-title::after {
    content: "_";
    animation: cursor-blink 1s steps(1) 8;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .site-logo img {
    display: block;
    width: 40px;
    height: auto;
    image-rendering: pixelated;
  }

  .site-nav .nes-btn {
    color: var(--color-text);
    font-weight: bold;
  }

  .site-nav .nes-btn.is-dark {
    background-color: var(--color-bg);
    border-color: var(--color-text);
  }

  footer {
    margin-top: 2.5rem;
    text-align: center;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-title::after {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .container {
      padding: 1.5rem;
    }
  }

  @media (min-width: 992px) {
    .container {
      padding: 2rem;
    }
  }

  @media (min-width: 1025px) {
    .layout-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    }
  }

  @media (max-width: 1024px) {
    .layout-grid {
      margin-top: 1rem;
    }
  }

  @media (max-width: 480px) {
    .site-logo {
      display: none;
    }

    .site-nav {
      gap: 0.5rem;
    }

    .site-nav .nes-btn {
      margin: 0;
      padding: 4px 6px;
      font-size: 10px;
    }
  }
</style>
